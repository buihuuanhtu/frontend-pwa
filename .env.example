# Public backend base URL. All VITE_* values are exposed to the browser.
# Leave empty for same-origin requests; set when the backend contract is known.
VITE_API_BASE_URL=

# Demo API used to acknowledge offline record synchronization.
# JSONPlaceholder accepts writes but does not persist them permanently.
VITE_DEMO_API_BASE_URL=https://jsonplaceholder.typicode.com
